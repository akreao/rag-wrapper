# Copy to .env and change the passwords.

# Database passwords.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Login the char and map servers use to talk to the login server.
# Letters, digits and _ only; 4 to 23 characters.
INTER_USER=wrapper_inter
INTER_PASSWORD=changeme123

# First admin account (GM group 99), created once on first start.
# The desktop app fills these in during setup. Same character rules as above.
ADMIN_USER=
ADMIN_PASSWORD=

# Address your game client connects to. 127.0.0.1 works when the client
# runs on this machine; use the machine's LAN IP for other computers.
PUBLIC_IP=127.0.0.1

# Port for the account portal, where players register and admins manage
# accounts: http://<this machine's LAN IP>:8080
PORTAL_PORT=8080

# The address of this machine the ports above and the game server's ports
# listen on. Empty listens on all of them. Set it to this machine's LAN or
# VPN address (an IPv4 address, usually the same as PUBLIC_IP) to keep the
# server off any other network the machine joins, such as public Wi-Fi.
# The server won't start while the machine doesn't have that address.
BIND_IP=

# rAthena build. PACKETVER must match your client's date. PRERE=yes builds
# pre-renewal (the default); PRERE=no builds renewal.
PACKETVER=20250716
PRERE=yes
RATHENA_REPO=https://github.com/akreao/rathena.git
# Commit on the rag-wrapper branch of the fork. Change it to pick up
# server changes, then rebuild.
RATHENA_COMMIT=266a587f6a0901bbd9d6935f359c7ff0bf65b9aa
# The commit the app's previous release came with, which Settings can go
# back to. Set it to the old RATHENA_COMMIT whenever that moves.
RATHENA_COMMIT_PREVIOUS=15a8dc848c1172e444e189ae4cd3de8ef5339a7c

# Where the app downloads prebuilt rAthena and portal images from, so the
# server doesn't compile on this computer. Settings without a published
# image (another PACKETVER, a hand-set commit) are still built here.
# Leave empty to always build here.
PREBUILT_IMAGES=ghcr.io/akreao/rag-wrapper
