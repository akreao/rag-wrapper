{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rag-wrapper",
  "version": "0.6.0",
  "identifier": "app.ragwrapper.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "rag-wrapper",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "resources": {
      "../../compose.yaml": "stack/compose.yaml",
      "../../docker/": "stack/docker/",
      "../../portal/": "stack/portal/",
      "../../overrides/README.md": "stack/overrides/README.md",
      "../../patches/README.md": "stack/patches/README.md",
      "../../mods/README.md": "stack/mods/README.md"
    },
    "category": "Game"
  }
}
